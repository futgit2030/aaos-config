# Grandmaster: PHC einmal auf TAI setzen (Systemzeit + 37 s), dann frei laufen lassen
service phc-init /vendor/bin/phc_ctl /dev/ptp0 set adj 37
    class late_start
    user root
    group root system
    capabilities SYS_TIME
    oneshot
    disabled
    seclabel u:r:gptp:s0

service gptp /vendor/bin/ptp4l -f /vendor/etc/gptp.cfg -i eth0
    class late_start
    user root
    group root system inet net_admin net_raw
    capabilities NET_ADMIN NET_RAW SYS_TIME
    disabled
    seclabel u:r:gptp:s0

# -O 0: Systemuhr fuehrt gPTP-Zeit (TAI) - Pflicht, wenn ein AVTP-Talker auf diesem
# Geraet laeuft (7, gemessen). Nur gPTP ohne AVTP: -O -37 (Systemuhr = UTC)
service phc2sys /vendor/bin/phc2sys -s /dev/ptp0 -c CLOCK_REALTIME -O 0 \
        -z /dev/socket/ptp4l
    class late_start
    user root
    group root system inet net_admin net_raw
    capabilities SYS_TIME
    disabled
    seclabel u:r:gptp:s0

on property:vendor.gptp.enable=1
    # nur Grandmaster (5); im Client-Betrieb streichen
    exec_start phc-init
    start gptp
    start phc2sys

on property:vendor.gptp.enable=0
    stop phc2sys
    stop gptp
